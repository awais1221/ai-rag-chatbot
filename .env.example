# Copy this file to .env and fill in your values. Never commit .env!
# Any OpenAI-compatible chat provider works. All options below have a free tier.

# --- Option 1: Google Gemini (free tier, recommended) -----------------------
# Get a free key at https://aistudio.google.com/apikey
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
API_KEY=your-api-key-here
MODEL_NAME=gemini-3.5-flash

# --- Option 2: Groq (free tier, very fast) -----------------------------------
# BASE_URL=https://api.groq.com/openai/v1
# API_KEY=your-groq-key-here
# MODEL_NAME=llama-3.3-70b-versatile

# --- Option 3: GitHub Models (free with a GitHub account) -------------------
# BASE_URL=https://models.github.ai/inference
# API_KEY=your-github-token-here
# MODEL_NAME=openai/gpt-4o-mini

# --- Option 4: Ollama (runs locally, 100% free & private) -------------------
# BASE_URL=http://localhost:11434/v1
# API_KEY=ollama
# MODEL_NAME=llama3.2

# --- Admin -------------------------------------------------------------------
# Required to upload documents / index websites from the web UI.
# Use a long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=

# --- Branding ----------------------------------------------------------------
BOT_NAME=Site Assistant
# Shown in the "I couldn't find that" reply (optional)
CONTACT_URL=
# Starter questions in the chat, separated by |
SUGGESTIONS=What can you help me with?|How does this work?

# --- Website embedding / security -------------------------------------------
# Websites allowed to use the chat widget (comma separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Set to true when running behind a proxy (Render, Hugging Face Spaces, nginx)
TRUST_PROXY=false

# --- Optional settings (defaults shown) -------------------------------------
# TOP_K=4                  # chunks retrieved per question
# MIN_SCORE=0.55           # similarity below this = "not in the docs" (no LLM call)
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120
# HISTORY_TURNS=3          # previous Q&A pairs sent for follow-up questions
# MAX_CRAWL_PAGES=50
# MAX_FILE_MB=15
# MAX_QUESTION_CHARS=500
# PER_IP_PER_MINUTE=8
# PER_IP_PER_DAY=60
# DAILY_CAP=500            # total chat messages per day, all visitors
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT=60
# DATA_DIR=./data          # where the vector database is stored

# --- Hosting ------------------------------------------------------------------
# Re-index these URLs automatically when the knowledge base is empty
# (free hosts like Render wipe the disk on restart). Comma separated.
# SEED_URLS=https://example.com/
